{
  "name": "FoodDeliveryFailureWorkflow",
  "description": "Compensation for FoodDeliveryWorkflow (attached via failureWorkflow). Rebuilt; see conductor/PROVENANCE.md.",
  "version": 1,
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "inputParameters": [
    "workflowId",
    "reason",
    "failureStatus",
    "failedWorkflow",
    "customerEmail",
    "customerName"
  ],
  "tasks": [
    {
      "name": "cancel_delivery",
      "taskReferenceName": "cancel_delivery_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${workflow.input.failedWorkflow.variables.orderId}"
      }
    },
    {
      "name": "cancel_payment",
      "taskReferenceName": "cancel_payment_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${workflow.input.failedWorkflow.variables.orderId}"
      }
    },
    {
      "name": "cancel_order",
      "taskReferenceName": "cancel_order_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${workflow.input.failedWorkflow.variables.orderId}"
      }
    },
    {
      "name": "notify_customer",
      "taskReferenceName": "notify_customer_failure_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${workflow.input.failedWorkflow.variables.orderId}",
        "customerEmail": "${workflow.input.customerEmail}",
        "customerName": "${workflow.input.customerName}"
      }
    }
  ],
  "outputParameters": {
    "orderId": "${workflow.input.failedWorkflow.variables.orderId}",
    "failedWorkflowId": "${workflow.input.workflowId}",
    "reason": "${workflow.input.reason}"
  }
}
