{
  "name": "FoodDeliveryFailureWorkflow",
  "description": "Compensation for FoodDeliveryWorkflow (attached via failureWorkflow). Does not depend on which task failed: always cancels delivery, payment and order in reverse order with allowMissing=true (a step that never wrote data is a no-op), then notifies the customer. orderId falls back to the failed workflow's workflowId, which order_food uses as the order id. See conductor/PROVENANCE.md and specs/saga.qnt (CurrentWorkflow).",
  "version": 1,
  "schemaVersion": 2,
  "restartable": true,
  "workflowStatusListenerEnabled": false,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 0,
  "inputParameters": [
    "workflowId",
    "reason",
    "failureStatus",
    "failedWorkflow",
    "customerEmail",
    "customerName"
  ],
  "tasks": [
    {
      "name": "extract_failure_context",
      "taskReferenceName": "extract_failure_context_ref",
      "type": "JSON_JQ_TRANSFORM",
      "inputParameters": {
        "parent": "${workflow.input.failedWorkflow}",
        "queryExpression": "{ orderId: (.parent.output.orderId // first(.parent.tasks[]? | select(.referenceTaskName == \"order_food_ref\") | .outputData.orderId) // .parent.workflowId), failedTaskName: .parent.failedReferenceTaskNames[0] }"
      }
    },
    {
      "name": "cancel_delivery",
      "taskReferenceName": "cancel_delivery_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${extract_failure_context_ref.output.result.orderId}",
        "allowMissing": true
      }
    },
    {
      "name": "cancel_payment",
      "taskReferenceName": "cancel_payment_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${extract_failure_context_ref.output.result.orderId}",
        "allowMissing": true
      }
    },
    {
      "name": "cancel_order",
      "taskReferenceName": "cancel_order_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${extract_failure_context_ref.output.result.orderId}",
        "allowMissing": true
      }
    },
    {
      "name": "notify_customer",
      "taskReferenceName": "notify_customer_failure_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "orderId": "${extract_failure_context_ref.output.result.orderId}",
        "customerEmail": "${workflow.input.customerEmail}",
        "customerName": "${workflow.input.customerName}"
      }
    }
  ],
  "outputParameters": {
    "orderId": "${extract_failure_context_ref.output.result.orderId}",
    "failedTaskName": "${extract_failure_context_ref.output.result.failedTaskName}",
    "failedWorkflowId": "${workflow.input.workflowId}",
    "reason": "${workflow.input.reason}"
  }
}
