# =========================================================================
# Spring Boot / Java / Gradle .gitignore
# =========================================================================

# --- Compiled Class files ---
*.class

# --- Package Files ---
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Gradle Build Output & Cache ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# --- Maven Build Output (Fallback) ---
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# --- Log Files ---
*.log
logs/
*.log.*
nohup.out

# --- JVM Crash Logs & Profiling ---
*.hprof
hs_err_pid*
replay_pid*

# --- Embedded Database (SQLite & Local DBs) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
food_delivery.db

# --- Environment Variables & Local Configurations ---
.env
.env.local
application-local.properties
application-local.yml
application-local.yaml

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# --- Eclipse ---
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
bin/

# --- Visual Studio Code ---
.vscode/
*.code-workspace

# --- NetBeans ---
/nbproject/private/
/build/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# --- Operating System Files ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
